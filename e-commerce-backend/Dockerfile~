# Use a full JDK (Debian-based) to avoid cgroup issues
FROM eclipse-temurin:17-jdk-jammy

WORKDIR /app

# Copy the built jar from target
COPY target/*.jar app.jar

# Expose port
EXPOSE 8080

# Disable Micrometer system metrics to prevent cgroup errors
ENV MANAGEMENT_METRICS_ENABLE_PROCESS=false
ENV MANAGEMENT_METRICS_ENABLE_SYSTEM_CPU=false
ENV MANAGEMENT_METRICS_ENABLE_SYSTEM_FILES=false
ENV MANAGEMENT_METRICS_ENABLE_SYSTEM_MEMORY=false

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]

